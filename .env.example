# Environment: development | production | test
NODE_ENV=development

# Database (PostgreSQL connection string)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# JWT signing secret — must be at least 16 characters; use a strong random value in production
JWT_SECRET=change-me-use-a-strong-random-secret

# Optional: dedicated refresh token signing secret. If omitted, JWT_SECRET is used.
JWT_REFRESH_SECRET=change-me-use-a-different-strong-random-secret

# Token expiration configuration
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins in production
# Example: FRONTEND_ORIGINS=http://localhost:5173,https://app.example.com
FRONTEND_ORIGINS=http://localhost:5173

# bcrypt hashing rounds (8–20). Higher = more secure but slower. 10 is a good default.
BCRYPT_ROUNDS=10
